<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MarkReader.Core.ViewModels"
        xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
        xmlns:ctxt="using:ColorTextBlock.Avalonia"
        x:Class="MarkReader.Desktop.MainWindow"
        Title="MarkReader"
        Icon="avares://MarkReader.Desktop/Assets/app-icon.ico"
        Width="1100" Height="750"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource InterFont}"
        Background="{DynamicResource ReaderBackgroundBrush}">

    <Window.Styles>

        <!-- ── Toolbar Button ─────────────────────────────────── -->
        <Style Selector="Button.toolbar-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.toolbar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
        <Style Selector="Button.toolbar-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
        </Style>

        <!-- ── Search TextBox ─────────────────────────────────── -->
        <Style Selector="TextBox.search-box">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="200"/>
        </Style>

        <!-- ── Status text ───────────────────────────────────── -->
        <Style Selector="TextBlock.status">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ReaderMutedBrush}"/>
        </Style>

        <!-- ── Search nav button ─────────────────────────────── -->
        <Style Selector="Button.nav-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.nav-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>

        <!-- ── Abas ──────────────────────────────────────────── -->
        <Style Selector="ListBox.tab-strip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="CornerRadius" Value="6,6,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBox.tab-strip ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/>
            <!-- O degrau de fundo entre aba ativa e inativa é de 1,1:1; a pista de verdade
                 é o traço de acento. -->
            <Setter Property="BorderBrush" Value="{DynamicResource ReaderQuoteBrush}"/>
            <Setter Property="BorderThickness" Value="0,2,0,0"/>
        </Style>

        <Style Selector="Button.tab-close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.tab-close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
        </Style>

    </Window.Styles>

    <DockPanel>

        <!-- ═══════════════════════════════════════════════
             TOOLBAR
        ════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                Padding="12,8"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Left: Open button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                    <Button Classes="toolbar-btn"
                            x:Name="OpenButton"
                            ToolTip.Tip="Abrir arquivo Markdown (Ctrl+O)"
                            Command="{Binding OpenFileCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📂" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Abrir" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center: App title -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                            Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="📖" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="MarkReader"
                               FontSize="17" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ReaderForegroundBrush}"/>
                </StackPanel>

                <!-- Right: Search + Theme toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Classes="toolbar-btn"
                            x:Name="SearchToggleButton"
                            IsEnabled="{Binding HasActiveDocument}"
                            ToolTip.Tip="Buscar no documento (Ctrl+F)"
                            Command="{Binding ToggleSearchCommand}">
                        <TextBlock Text="🔍" FontSize="16"/>
                    </Button>
                    <Button Classes="toolbar-btn"
                            x:Name="ThemeButton"
                            ToolTip.Tip="Alternar tema claro/escuro (Ctrl+T)"
                            Command="{Binding ToggleThemeCommand}">
                        <TextBlock x:Name="ThemeIcon" Text="🌙" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             ABAS
        ════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasActiveDocument}"
                Padding="10,4,10,0"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ListBox Classes="tab-strip"
                         x:Name="TabStrip"
                         ItemsSource="{Binding OpenDocuments}"
                         SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding FileName}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           ToolTip.Tip="{Binding FilePath}"/>
                                <Button Classes="tab-close"
                                        ToolTip.Tip="Fechar aba (Ctrl+W)"
                                        Command="{Binding $parent[ListBox].DataContext.CloseDocumentCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="✕"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- ═══════════════════════════════════════════════
             STATUS BAR
        ════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Padding="14,5"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="status" Text="{Binding StatusMessage}"/>
                <TextBlock Grid.Column="1" Classes="status" Margin="0,0,16,0"
                           Text="{Binding SelectedDocument.FileName}"
                           IsVisible="{Binding HasActiveDocument}"/>
                <TextBlock Grid.Column="2" Classes="status"
                           Text="{Binding SelectedDocument.FileSizeText}"
                           IsVisible="{Binding HasActiveDocument}"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             SEARCH BAR (collapsible)
        ════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding IsSearchVisible}"
                Padding="12,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">

                <TextBlock Grid.Column="0" Text="Buscar:" VerticalAlignment="Center"
                           FontWeight="Medium" Margin="0,0,8,0" FontSize="13"/>

                <TextBox Grid.Column="1"
                         Classes="search-box"
                         x:Name="SearchBox"
                         Text="{Binding SearchQuery, Mode=TwoWay}"
                         Watermark="Digite para buscar…"
                         MaxWidth="400"/>

                <!-- result count -->
                <TextBlock Grid.Column="2"
                           Text="{Binding SearchCountText}"
                           VerticalAlignment="Center"
                           Margin="10,0"
                           FontSize="13"
                           Foreground="{DynamicResource ReaderMutedBrush}"/>

                <!-- prev / next -->
                <Button Grid.Column="3"
                        Classes="nav-btn"
                        ToolTip.Tip="Resultado anterior (Shift+Enter)"
                        Command="{Binding PreviousResultCommand}">
                    <TextBlock Text="◀" FontSize="13"/>
                </Button>
                <Button Grid.Column="4"
                        Classes="nav-btn"
                        ToolTip.Tip="Próximo resultado (Enter)"
                        Command="{Binding NextResultCommand}">
                    <TextBlock Text="▶" FontSize="13"/>
                </Button>

                <!-- close -->
                <Button Grid.Column="5"
                        Classes="nav-btn"
                        ToolTip.Tip="Fechar busca (Esc)"
                        Command="{Binding CloseSearchCommand}"
                        Margin="8,0,0,0">
                    <TextBlock Text="✕" FontSize="13"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════
             MAIN CONTENT AREA
        ════════════════════════════════════════════════════ -->
        <Grid>
            <!-- Drop zone / empty state -->
            <Border x:Name="EmptyState"
                    IsVisible="{Binding !HasActiveDocument}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="📄" FontSize="64" HorizontalAlignment="Center"
                               Opacity="0.4"/>
                    <TextBlock Text="Abra um arquivo Markdown"
                               FontSize="22" FontWeight="Light"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource ReaderMutedBrush}"/>
                    <TextBlock Text="Clique em 📂 Abrir ou arraste um arquivo .md para cá"
                               FontSize="14" HorizontalAlignment="Center"
                               Foreground="{DynamicResource ReaderMutedBrush}"/>
                    <Button HorizontalAlignment="Center"
                            Padding="20,10"
                            CornerRadius="8"
                            Command="{Binding OpenFileCommand}">
                        <TextBlock Text="Abrir arquivo…" FontWeight="Medium"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Um visualizador vivo por aba, empilhados: trocar de aba esconde e mostra,
                 sem re-parsear o markdown nem perder a posição de leitura. -->
            <ItemsControl x:Name="DocumentHost"
                          ItemsSource="{Binding OpenDocuments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ScrollViewer IsVisible="{Binding IsActive}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <!-- MaxWidth 680: a ~16px, dá a medida de 60-75 caracteres por
                                 linha da leitura longa. Os 860 anteriores davam 95-110. -->
                            <md:MarkdownScrollViewer Markdown="{Binding MarkdownContent}"
                                          Margin="40,32"
                                          MaxWidth="680"
                                          HorizontalAlignment="Center">
                                <md:MarkdownScrollViewer.Styles>
                                    <!-- Corpo: 16px com entrelinha 1,6 (WCAG 1.4.12 pede >= 1,5) -->
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Paragraph">
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="LineHeight" Value="26"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ReaderForegroundBrush}"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.ListMarker">
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="LineHeight" Value="26"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ReaderMutedBrush}"/>
                                    </Style>

                                    <!-- Escala de títulos: 1.75 / 1.375 / 1.15 sobre o corpo -->
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading1">
                                        <Setter Property="FontSize" Value="28"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="LineHeight" Value="36"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ReaderForegroundBrush}"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading2">
                                        <Setter Property="FontSize" Value="22"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="LineHeight" Value="30"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ReaderForegroundBrush}"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading3, .Markdown_Avalonia_MarkdownViewer ctxt|CTextBlock.Heading4">
                                        <Setter Property="FontSize" Value="18"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="LineHeight" Value="26"/>
                                        <Setter Property="Foreground" Value="{DynamicResource ReaderForegroundBrush}"/>
                                    </Style>

                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CHyperlink">
                                        <Setter Property="Foreground" Value="{DynamicResource ReaderLinkBrush}"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer ctxt|CCode">
                                        <Setter Property="Foreground" Value="{DynamicResource ReaderCodeBrush}"/>
                                        <Setter Property="Background" Value="{DynamicResource ReaderSurfaceBrush}"/>
                                    </Style>

                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.CodeBlock">
                                        <Setter Property="Background" Value="{DynamicResource ReaderSurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ReaderBorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Blockquote">
                                        <Setter Property="Background" Value="{DynamicResource ReaderSurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ReaderQuoteBrush}"/>
                                        <Setter Property="BorderThickness" Value="4,0,0,0"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.Table, .Markdown_Avalonia_MarkdownViewer Grid.Table > Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ReaderBorderBrush}"/>
                                    </Style>
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer Border.TableHeader">
                                        <Setter Property="Background" Value="{DynamicResource ReaderSurfaceBrush}"/>
                                    </Style>
                                    <!-- O texto do bloco cercado é TextBlock puro, não CTextBlock -->
                                    <Style Selector=".Markdown_Avalonia_MarkdownViewer TextBlock.CodeBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ReaderForegroundBrush}"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </md:MarkdownScrollViewer.Styles>
                            </md:MarkdownScrollViewer>
                        </ScrollViewer>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

    </DockPanel>
</Window>
